# Local development. Never commit this file.
DATABASE_URL="postgresql://shlonek:shlonek@127.0.0.1:54329/shlonek?schema=public"
DIRECT_URL="postgresql://shlonek:shlonek@127.0.0.1:54329/shlonek?schema=public"

# Local dev runs on 3001 here (3000 is taken). Production: https://shlonek.com
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ─── Supabase (Google sign-in) ─────────────────────────────────────────
# Supabase → Project Settings → API
#   Project URL          → NEXT_PUBLIC_SUPABASE_URL   (https://xxxx.supabase.co)
#   Publishable/anon key → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Leave empty to use only the dev login locally.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Google OAuth client (Google Cloud Console → Credentials).
# Reference only: paste these two into Supabase → Authentication → Providers → Google.
# The app itself never reads them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Later, to use the Supabase database instead of local Docker
# (Supabase → Project Settings → Database → Connection string):
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Dev-only login (ignored when NODE_ENV=production)
DEV_LOGIN_ENABLED="false"
SESSION_SECRET="generate-with: openssl rand -hex 32"

# Emails that become ADMIN on first sign-in (comma separated).
# Add the owner's real Gmail here, e.g. "admin@shlonek.local,owner@gmail.com"
ADMIN_EMAILS="admin@shlonek.local"

# Wayl payments. Leave WAYL_API_KEY empty to run wallet-only.
WAYL_API_KEY=""
WAYL_WEBHOOK_SECRET=""
WAYL_ENV="test"
WAYL_API_URL="https://api.thewayl.com"

# ─── Email (Resend) ───────────────────────────────────────────────────
# resend.com → API Keys → create key → paste here. Empty = emails are only logged.
RESEND_API_KEY=""
# Sender. Must be on a domain verified in Resend (Domains → add shlonek.com).
# For a quick test before verifying the domain you can use: "شلونك <onboarding@resend.dev>"
EMAIL_FROM="شلونك <no-reply@shlonek.com>"
# Who receives the "new «احچيلي» message" alert (comma separated).
# Empty = the real (non-.local) emails in ADMIN_EMAILS are used.
ADMIN_NOTIFY_EMAILS=""

# Protects the cron route that expires holds
CRON_SECRET="generate-with: openssl rand -hex 16"

# ─── VdoCipher (DRM video for paid courses / premium workshops) ───
# Dashboard → Config → API Keys. Leave empty until the account is ready:
# VdoCipher lessons then show "not available yet" instead of playing.
VDOCIPHER_API_SECRET=""
